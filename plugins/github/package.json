{
  "name": "bb-plugin-github-prs",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.43.1",
    "bbPluginSdk": ">=0.4.87"
  },
  "bb": {
