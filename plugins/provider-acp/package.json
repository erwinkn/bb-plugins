{
  "name": "bb-plugin-provider-acp-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Run bb threads with ACP agents (Cursor, opencode, omp, Grok, Hermes and custom agents), with OptChat memory turns.",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "ACP providers (OptChat)",
    "description": "Run bb threads with ACP agents (Cursor, opencode, omp, Grok, Hermes and custom agents), with OptChat memory turns.",
    "branding": {
      "icon": "./icons/acp.svg",
      "experimental_icons": {
        "cursor": "./icons/cursor.svg",
        "opencode": "./icons/opencode.svg",
        "omp": "./icons/omp.svg",
        "grok": "./icons/grok.svg",
        "hermes-agent": "./icons/hermes-agent.svg"
      }
    },
    "server": "./server.ts",
    "host": "./src/host.ts",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "acp-cursor",
        "displayName": "Cursor"
      },
      {
        "kind": "agent",
        "id": "acp-opencode",
        "displayName": "OpenCode"
      },
      {
        "kind": "agent",
        "id": "acp-omp",
        "displayName": "oh-my-pi"
      },
      {
        "kind": "agent",
        "id": "acp-grok",
        "displayName": "Grok"
      },
      {
        "kind": "agent",
        "id": "acp-hermes-agent",
        "displayName": "Hermes"
      }
    ]
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix ../../lib/acp-bridge --no-audit --no-fund",
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
