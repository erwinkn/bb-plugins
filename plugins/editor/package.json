{
  "name": "bb-plugin-editor",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.43.1",
    "bbPluginSdk": ">=0.4.87"
  },
  "bb": {
    "name": "Editor",
    "description": "Pierre file editor with a Files panel, an editable Changes diff tab, and BB-matched syntax colors.",
    "branding": {
      "icon": "Code"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "1.1.10",
    "@pierre/trees": "1.0.0-beta.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@get-bb/plugin-sdk": "0.4.87",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "5.5.0",
    "esbuild": "0.28.2",
    "hono": "4.13.7",
    "shiki": "4.4.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vaul": "^1.1.2"
  },
  "private": true,
  "scripts": {
    "build": "npm run build:pierre && bb plugin build",
    "build:pierre": "node scripts/stage-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/*.test.ts server.test.ts host.test.ts",
    "check:assets": "node scripts/check-assets.mjs"
  }
}
