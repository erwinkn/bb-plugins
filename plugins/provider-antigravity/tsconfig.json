{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["server.ts", "host.ts", "app.tsx", "src/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx", "vitest.config.ts"]
}
